# Copy to /opt/openmuse/.env on the VPS (chmod 600). Never commit the real file.
# Generate secrets with: openssl rand -base64 32

# Public domain whose DNS A/AAAA record points at the VPS. Caddy issues HTTPS for it.
DOMAIN=muse.example.com

# A public server must use live mode: it requires the access key to sign in.
WORKSPACE_MODE=live
AGENT_BACKEND=model
MODEL=openai/your-model-id
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

CPK_INTELLIGENCE_API_KEY=
# 24+ random characters; you type it to sign in.
OPENMUSE_ACCESS_KEY=
# 32 random bytes as base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# 32+ random characters shared by the API and browser worker.
WORKER_TOKEN=

# Optional Google workspace. Redirect URI: https://<DOMAIN>/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

TASK_WORKER_ENABLED=true
COMPUTER_ENABLED=false
