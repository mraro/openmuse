# Template for /opt/openmuse/.env on the VPS. Never commit the real file.
# Run ./deploy.sh in a terminal on the VPS: it asks which network answers
# (tailnet, public or local) and for every empty value below, then saves them here.

# A server must use live mode: it requires the access key to sign in.
WORKSPACE_MODE=live
AGENT_BACKEND=model
# provider/model-id, e.g. openai/..., anthropic/... or google/...
MODEL=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

CPK_INTELLIGENCE_API_KEY=
# 24+ random characters; you type it to sign in.
OPENMUSE_ACCESS_KEY=
# 32 random bytes as base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# 32+ random characters shared by the API and browser worker.
WORKER_TOKEN=

# Optional Google workspace. Redirect URI: https://<DOMAIN>/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

TASK_WORKER_ENABLED=true
COMPUTER_ENABLED=false
